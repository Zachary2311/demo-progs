{
  "name": "cf-chat",
  "version": "1.0.0",
  "description": "Production-ready chat website on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build",
    "build:worker": "tsc --project tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy",
    "type-check": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "seed": "wrangler d1 execute cf-chat-db --file=./migrations/0001_init.sql",
    "migrate": "wrangler d1 execute cf-chat-db --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.0.0",
    "jose": "^5.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.21.0",
    "react-syntax-highlighter": "^15.5.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^13.3.1",
    "msw": "^2.1.4",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.0",
    "wrangler": "^3.25.0"
  },
  "overrides": {
    "glob": "^10.3.10",
    "rimraf": "^5.0.5",
    "inflight": "npm:@aashutoshrathi/inflight@^1.0.0",
    "sourcemap-codec": "@jridgewell/sourcemap-codec",
    "rollup-plugin-inject": "@rollup/plugin-inject"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
